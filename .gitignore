# Python bytecode and cache
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/

# IDE files
.vscode/
.idea/

# Local test and coverage artifacts
.pytest_cache/
.coverage
htmlcov/

# OS files
.DS_Store
Thumbs.db

# Project output data
output/*.json
output/*.jpg
output/*.png

# Keep project folders but ignore generated content
!input/.gitkeep
!output/.gitkeep
